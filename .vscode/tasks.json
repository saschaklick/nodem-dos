{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "cargo",
            "command": "build",
            "args": [
                "-Zjson-target-spec",                
                "--release"           
            ],
            "problemMatcher": ["$rustc"],
        },
        {
            "label": "link",
            "type": "cargo",
            "command": "objcopy",
            "args": [
                "-Zjson-target-spec",                
                "--release",                
                "--",
                "-O", "binary",
                "--binary-architecture=i386:x86",                
                "build/nodem.com"
            ],
            "dependsOn": ["build"],
        },
        {
            "label": "link with vm",
            "type": "cargo",
            "command": "objcopy",
            "args": [
                "-Zjson-target-spec",                
                "--release",
                "--features", "default,vm",
                "--",
                "-O", "binary",
                "--binary-architecture=i386:x86",                
                "build/nodem.com"
            ],
            "dependsOn": ["build"],
        },
        {
            "label": "run",
            "type": "shell",
            "command": "dosbox -conf ${workspaceFolder}/build/dosbox.conf",
            "dependsOn" : ["link"]
        },
        {
            "label": "run with vm",
            "type": "shell",
            "command": "dosbox -conf ${workspaceFolder}/build/dosbox.conf",
            "dependsOn" : ["link with vm"]
        },
        {
            "label": "bloat",
            "type": "cargo",
            "command": "bloat",
            "args": [
                "-Zjson-target-spec",                
                "--release",
                "--",                
                "--binary-architecture=i386:x86",                                
            ],
            "dependsOn": ["build"],
        },
        {
            "label": "clean",
            "type": "cargo",
            "command": "clean"
        },
    ]
}
